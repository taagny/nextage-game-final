{
  "name": "nextage-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/run-emulator-tests.mjs app",
    "build": "vite build",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:auth": "node scripts/run-emulator-tests.mjs auth",
    "test:rules": "node scripts/run-emulator-tests.mjs firestore",
    "test:integration": "node scripts/run-emulator-tests.mjs integration",
    "test:persistence": "node scripts/run-emulator-tests.mjs persistence-save && node scripts/run-emulator-tests.mjs persistence-load",
    "test:local": "node --test tests/local/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "preview": "vite preview",
    "generate:dict": "node scripts/generateDictionary.js",
    "validate:dict": "node scripts/validateDictionary.js"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.35.0",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}

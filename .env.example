VITE_CONTACT_EMAIL=
# UIDs de desenvolvedor/teste separados por vírgula. Não versionar valores reais.
VITE_EXCLUDED_FROM_RESEARCH_UIDS=

# Opcional: Firebase separado para o preview da Vercel.
